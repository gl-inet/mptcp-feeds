#!/bin/sh

. /usr/share/libubox/jshn.sh
CFG=/etc/mptun/node_params
CLI_CFG=/etc/mptun/vmessclient.cfg

[ -e $CFG ] || exit 1
sed -i 's/\\\//\//g' $CFG

dst_tag="$1"
dst_ipv4=""
dst_ipv6=""
dst_tcpport=""
dst_udpport=""
dst_subnet=""
dst_prvkey=""
dst_pubkey=""
dst_uuid=""

get_dst_val()
{
	json_load_file $CFG
	json_select cfg
	json_get_keys keys

	for i in $keys; do
		json_select $i
		json_get_var tag tag
		[ "$tag" = "$dst_tag" ] || {
			json_select ..
			continue
		}

		json_get_var ipv4 ipv4 
		[ -n "$ipv4" ] || exit 2
		dst_ipv4=$ipv4

		json_get_var tcp_port tcp_port
		[ -n "$tcp_port" ] || exit 3
		dst_tcpport=$(expr $tcp_port + 0)

		json_get_var udp_port udp_port
		[ -n "$udp_port" ] || exit 4
		dst_udpport=$(expr $udp_port + 0)

		json_get_var subnet subnet
		[ -n "$subnet" ] || exit 5
		dst_subnet=$subnet

		json_get_var prv_key prv_key
		[ -n "$prv_key" ] || exit 6
		dst_prvkey=$prv_key

		json_get_var pub_key pub_key
		[ -n "$pub_key" ] || exit 7
		dst_pubkey=$pub_key

		json_get_var uuid uuid
		[ -n "$uuid" ] || exit 8
		dst_uuid=$uuid

		json_select ..
	done
}

update_cfg()
{
	json_load_file $CLI_CFG
	json_select outbounds
	json_select 1

	json_get_var tag tag
	[ -n "$dst_tag" -a -n "$tag" ] || exit 9
	sed -i 's/"tag": "'"$tag"'"/"tag": "'"$dst_tag"'"/' $CLI_CFG

	json_get_var settings settings
	[ -n "$settings" ] || exit 10
	json_select settings

	json_is_a vnext array ||exit 11
	json_select vnext
	json_select 1

	json_get_var addr address
	[ -n "$addr" -a -n "$dst_ipv4" ] || exit 12
	sed -i 's/"address": "'"$addr"'"/"address": "'"$dst_ipv4"'"/' $CLI_CFG

	json_get_var port port
	[ -n "$port" -a -n "$dst_tcpport" ] ||exit 13
	sed -i 's/"port": '$port'/"port": '$dst_tcpport'/' $CLI_CFG

	json_is_a users array || exit 14
	json_select users
	json_select 1

	json_get_var uuid id
	[ -n "$uuid" -a "$dst_uuid" ] || exit 15
	sed -i 's/"id": "'"$uuid"'"/"id": "'"$dst_uuid"'"/' $CLI_CFG

	json_select ..
	json_select ..

	json_is_a udptun object || exit 16
	json_select udptun

	json_is_a interface object || exit 17
	json_select interface

	json_get_var addr Address
	[ -n "$addr" -a -n "$dst_subnet" ] || exit 18
	addr="$(echo "$addr"|sed 's/\//\\\//g')"
	dst_subnet="$(echo "$dst_subnet"|sed 's/\//\\\//g')"

	sed -i 's/"Address" : "'"$addr"'"/"Address" : "'"$dst_subnet"'"/' $CLI_CFG

	json_get_var prvkey PrivateKey
	[ -n "$prvkey" -a -n "$dst_prvkey" ] || exit 19
	prvkey="$(echo "$prvkey"|sed 's/\//\\\//g')"
	dst_prvkey="$(echo "$dst_prvkey"|sed 's/\//\\\//g')"
	sed -i 's/"PrivateKey" : "'"$prvkey"'"/"PrivateKey" : "'"$dst_prvkey"'"/' $CLI_CFG 

	json_select ..
	json_is_a peers array || exit 20
	json_select peers
	json_select 1

	json_get_var pubkey PublicKey
	[ -n "$pubkey" -a -n "$dst_pubkey" ] || exit 21
	pubkey="$(echo "$pubkey"|sed 's/\//\\\//g')"
	dst_pubkey="$(echo "$dst_pubkey"|sed 's/\//\\\//g')"
	sed -i 's/"PublicKey" : "'"$pubkey"'"/"PublicKey" : "'"$dst_pubkey"'"/' $CLI_CFG

	json_get_var endpoint Endpoint
	[ -n "$endpoint" -a -n "$dst_udpport" ] ||exit 22
	sed -i 's/"Endpoint" : "'"$endpoint"'"/"Endpoint" : "'"$dst_ipv4":"$dst_udpport"'"/' $CLI_CFG

}

get_dst_val
update_cfg
