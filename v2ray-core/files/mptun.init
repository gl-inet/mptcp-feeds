#!/bin/sh /etc/rc.common

USE_PROCD=1
START=89

CONF="mptun"
PROG="/usr/bin/mptun"
MPTUN_RESOLVFILE=/tmp/resolv.conf.mptun/resolv.conf.auto
DEFAULT_RESOLVFILE=/tmp/resolv.conf.d/resolv.conf.auto

. /lib/functions/mptun.sh

update_modem_cfg()
{
	local modem_iface=$(ubus list|grep interface.modem|grep -v -E '4|6')
	[ -z "$modem_iface" ] && return

	local modem_name="$(echo $modem_iface|cut -d. -f3)"
	[ -z "$modem_name" ] && return

	local ubus_data="$(ubus call ${modem_iface}_4 status)"
	[ -z "$ubus_data" ] && ubus_data="$(ubus call ${modem_iface} status)"

	local up="$(echo $ubus_data|jsonfilter -e "@.up")"
	local online_dev
	[ $up = true ] && online_dev="$(echo $ubus_data|jsonfilter -e "@.l3_device")"
	[ -z "$online_dev" ] && return

	__load_member() {
		[ -z "$(echo $1|grep modem)" ] && return
		local enable=$(uci get mptun.$1.enable)
		[ -z "$enable" ] && enable='0'
		[ "$1" != "$modem_name" -a "$1" != "${modem_name}_4" ] && {
			uci del mptun.$1
			uci set mptun.${modem_name}_4=interface
			uci set mptun.${modem_name}_4.enable=$enable
			uci set mptun.${modem_name}_4.metric='6'
			uci set mptun.${modem_name}_4.device=$online_dev
			uci add_list mptun.${modem_name}_4.mptcp_flags='subflow'
			uci commit mptun
			sync
		}
	}
	config_foreach __load_member interface
}

update_conf() {
	[ -z "$1" ] && return
	local inited=$(uci -q get mptun.$1.inited)
	update_devinfo "$1"
}

start_service() {
	config_load "$CONF"

	local enabled dev udpmark tcpmark resolvfile use_exit dns
	config_get_bool enabled "global" "enable" "0"
	config_get dev "global" "mptun" "mptun0"
	config_get udpmark "global" "udpmark" "0x2"
	config_get tcpmark "global" "tcpmark" "0x1"

	config_foreach update_conf interface

	[ "$enabled" -eq "1" ] || return 1
	local profile
	config_get profile "config" "profile"
	[ -z "$profile" ] && return 1

	update_modem_cfg

	resolvfile=$(uci get dhcp.@dnsmasq[0].resolvfile)
	[ "$resolvfile" != "$MPTUN_RESOLVFILE" -a "$resolvfile" != "$DEFAULT_RESOLVFILE" ] && {
		uci set mptun.config.sys_resolvfile="$resolvfile"
		uci commit mptun
	}

	config_get use_exit "global" "use_exit" "0"
	config_get dns "global" "dns" "127.0.0.1"
	[ "$use_exit" = "1" -a "$dns" != "127.0.0.1" ] && {
		mkdir -p /tmp/resolv.conf.mptun
		touch $MPTUN_RESOLVFILE
		uci set dhcp.@dnsmasq[0].resolvfile="$MPTUN_RESOLVFILE"
		uci commit dhcp
		echo "nameserver $dns" > $MPTUN_RESOLVFILE
		/etc/init.d/dnsmasq reload
	}
	sync

	mptun_init "$profile" "$dev" "$udpmark" "$tcpmark"

	[ -e "/var/run/mpnode.json" ] || return

	procd_open_instance "$CONF"
	procd_set_param command "$PROG" run
	procd_append_param command -config "/etc/mptun/basic.json" -config "/var/run/mpnode.json" -format json
	[ -f "/var/run/mptun_dns.json" ] && procd_append_param command -config "/var/run/mptun_dns.json"
	procd_set_param limits core="unlimited"
	procd_set_param limits nofile="1000000 1000000"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance
	echo c >/proc/net/nf_conntrack
}

stop_service() {
	local resolvfile sys_resolvfile
	[ -e "/var/run/mpnode.json" ] && killall -9 $PROG
	mptun_clean

	[ -e $MPTUN_RESOLVFILE ] && rm -rf /tmp/resolv.conf.mptun
	resolvfile=$(uci get dhcp.@dnsmasq[0].resolvfile)
	sys_resolvfile=$(uci get mptun.config.sys_resolvfile)
	[ "$resolvfile" = "$MPTUN_RESOLVFILE" ] && {
		uci set dhcp.@dnsmasq[0].resolvfile="$sys_resolvfile"
		uci commit dhcp
		sync
		/etc/init.d/dnsmasq reload
	}
	iptables -t nat -F SDWAN_IP_MAPPING 2>/dev/null
	iptables -t nat -F SDWAN_IP_MAPPING_SNAT 2>/dev/null

	iptables -t nat -D PREROUTING -j SDWAN_IP_MAPPING 2>/dev/null
	iptables -t nat -D OUTPUT -j SDWAN_IP_MAPPING 2>/dev/null
	iptables -t nat -D POSTROUTING -j SDWAN_IP_MAPPING_SNAT 2>/dev/null

	iptables -t nat -X SDWAN_IP_MAPPING 2>/dev/null
	iptables -t nat -X SDWAN_IP_MAPPING_SNAT 2>/dev/null

	lanmark=$(uci get mptun.global.lanmark 2>/dev/null || echo "0x4")
	iptables -t mangle -D FORWARD -i br-lan -o br-lan -m comment --comment SDWAN_IP_MAPPING_MARK -j MARK --set-xmark $lanmark/$lanmark 2>/dev/null
}
