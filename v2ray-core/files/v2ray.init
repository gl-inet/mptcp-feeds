#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99

CONF="v2ray"
PROG="/usr/bin/v2ray"

clean_proxy() {
	rm  /etc/nftables.d/mptcp-proxy.nft 2>/dev/null
	/usr/bin/proxy-route.sh "clean" 2>/dev/null
	nft delete table inet mpass 2>/dev/null
    nft delete table inet mproxy 2>/dev/null
}

set_proxy() {
	local host port
	host="$(jsonfilter -i $1 -e  '@["outbounds"][0].settings.vnext[0].address')"
	if [ -z $host ]; then
		host="$(jsonfilter -i $1 -e  '@["outbounds"][0].settings.servers[0].address')"
	fi
	port="$(jsonfilter -i $1 -e  '@["inbounds"][0].port')"

cat > /var/run/mptun.nft << EOF
#!/usr/sbin/nft -f
define SERVER = {$host}
define PROXY_PORT = $port
EOF

	nft -f /usr/bin/mptcp-proxy.nft
	/usr/bin/proxy-route.sh "set"
	ln -s /usr/bin/mptcp-proxy.nft /etc/nftables.d
}

start_service() {
	config_load "$CONF"

	local enabled
	config_get_bool enabled "enabled" "enabled" "0"
	[ "$enabled" -eq "1" ] || return 1

	local profile
	local conffiles
	local datadir
	local format

	config_get profile "config" "profile"
	[ -e "$profile" ] || return 1

	procd_open_instance "$CONF"
	procd_set_param command "$PROG" run
	procd_append_param command -config "$profile" -format json


	procd_set_param limits core="unlimited"
	procd_set_param limits nofile="1000000 1000000"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance
	set_proxy "$profile"
}

stop_service() {  
    killall -9 $PROG
	clean_proxy                                                                                                          
}  
