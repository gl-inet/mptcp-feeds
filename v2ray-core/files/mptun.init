#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99

CONF="mptun"
PROG="/usr/bin/mptun"

clean_proxy() {
	#rm  /etc/nftables.d/mptcp-proxy.nft 2>/dev/null
	/usr/bin/proxy-route.sh "clean" 2>/dev/null
	nft delete table inet mpass 2>/dev/null
    nft delete table inet mproxy 2>/dev/null
}

set_proxy() {
	local host port
	host="$(jsonfilter -i $1 -e  '@["outbounds"][0].settings.vnext[0].address')"
	if [ -z $host ]; then
		host="$(jsonfilter -i $1 -e  '@["outbounds"][0].settings.servers[0].address')"
	fi
	port="$(jsonfilter -i $1 -e  '@["inbounds"][0].port')"

cat > /var/run/mptun.nft << EOF
#!/usr/sbin/nft -f
define SERVER = {$host}
define PROXY_PORT = $port
define UDPMARK = "$3"
define TCPMARK = "$2"
EOF

	nft -f /usr/bin/mptcp-proxy.nft
	/usr/bin/proxy-route.sh "set"
	#ln -s /usr/bin/mptcp-proxy.nft /etc/nftables.d
}

set_udptun() {
	local cfg="$(jsonfilter -i $1 -e '@.udptun')"
	[ -z "$cfg" ] && return
	eval $(echo $cfg|jsonfilter -e 'UDPTUN_IP=@.ip' -e 'UDPTUN_MASK=@.netmask' -e 'UDPTUN_P2P=@.pointopoint' \
		-e 'UDPTUN_SERVER=@.server' -e 'UDPTUN_PORT=@.port' -e 'UDPTUN_KEY=@.key')
	local KEYFILE="/var/run/mpudp.key"
	local DEV=$2
	local MARK=$3

	echo "$UDPTUN_KEY" >"$KEYFILE"
	procd_open_instance "mpudptun"
	procd_set_param command /usr/sbin/glorytun-udp bind 0.0.0.0 to $UDPTUN_SERVER $UDPTUN_PORT dev $DEV keyfile $KEYFILE
	procd_set_param limits core="unlimited"
	procd_set_param limits nofile="1000000 1000000"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance

	[ -z "$(uci -q get firewall.mptun)" ] && {
		uci set firewall.mptun=zone
		uci set firewall.mptun.name='mptun'
		uci set firewall.mptun.device="$DEV"
		uci set firewall.mptun.input='DROP'
		uci set firewall.mptun.output='ACCEPT'
		uci set firewall.mptun.forward='DROP'
		uci set firewall.mptun.masq='1'
		uci set firewall.mptun.mtu_fix='1'
		uci set firewall.lan2mptun=forwarding
		uci set firewall.lan2mptun.src='lan'
		uci set firewall.lan2mptun.dest='mptun'
		uci commit firewall
		/etc/init.d/firewall reload
	}

	[ -z "$(uci -q get network.mpudptun_rule)" ] && {
		uci set network.mpudptun_rule=rule
		uci set network.mpudptun_rule.mark="$MARK"
		uci set network.mpudptun_rule.lookup='30'
		uci set network.mpudptun_rule.priority='30'
		uci commit network
		/etc/init.d/network reload
	}
	
	(sleep 3 && ifconfig "$DEV" "$UDPTUN_IP" netmask "$UDPTUN_MASK"  pointopoint "$UDPTUN_P2P" up) &
}

clean_udptun() {
	[ -n "$(uci -q get firewall.mptun)" ] && {
		uci del firewall.mptun
		uci del firewall.lan2mptun
		uci commit firewall
		/etc/init.d/firewall reload
	}

	[ -n "$(uci -q get network.mpudptun_rule)" ] && {
		uci del network.mpudptun_rule
		uci commit network
		/etc/init.d/network reload
	}
	killall -9 /usr/sbin/glorytun-udp
}


start_service() {
	config_load "$CONF"

	local enabled dev udpmark tcpmark
	config_get_bool enabled "global" "enable" "0"
	config_get dev "global" "mptun" "mptun0"
	config_get udpmark "global" "udpmark" "0x2"
	config_get tcpmark "global" "tcpmark" "0x1"

	[ "$enabled" -eq "1" ] || return 1

	local profile
	local conffiles
	local datadir
	local format

	config_get profile "config" "profile"
	[ -e "$profile" ] || return 1

	procd_open_instance "$CONF"
	procd_set_param command "$PROG" run
	procd_append_param command -config "$profile" -format json

	procd_set_param limits core="unlimited"
	procd_set_param limits nofile="1000000 1000000"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance
	set_udptun "$profile" "$dev" "$udpmark"
	set_proxy "$profile" "$tcpmark" "$udpmark"
	echo c >/proc/net/nf_conntrack
}

stop_service() {  
    killall -9 $PROG
	clean_udptun
	clean_proxy                                                                                                          
}  
